<.header>
  Listing Posts
  <:actions>
    <.link patch={~p"/posts/new"}>
      <.button>New Post</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="posts"
  rows={@posts}
  row_click={fn post -> JS.navigate(~p"/posts/#{post}") end}
>
  <:col :let={post} label="Name"><%= post.name %></:col>
  <:col :let={post} label="Author"><%= post.author %></:col>
  <:action :let={post}>
    <div class="sr-only">
      <.link navigate={~p"/posts/#{post}"}>Show</.link>
    </div>
    <.link patch={~p"/posts/#{post}/edit"}>Edit</.link>
  </:action>
  <:action :let={post}>
    <.link
      phx-click={JS.push("delete", value: %{id: post.id}) |> hide("##{post.id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>
<div class="pagination">
  <%= if @page_number > 1 do %>
    <%= live_patch("<<Prev Page",
      to: TodoWeb.Router.Helpers.post_index_path(@socket, :index, page: %{page: @page_number - 1}),
      class: "pagination-link"
    ) %>
  <% end %>
  <div>
  <%= for id <- Enum.to_list(1..@total_pages) do %>
   <%= live_patch(
      to: TodoWeb.Router.Helpers.post_index_path(@socket, :index, page: %{page: id}),
      class: "pagination-link"
    ) do %>
    <%= id %>
   <% end %> 
  <% end %>
  </div>
  <%= if @page_number < @total_pages do %>
    <%= live_patch("Next Page>>",
      to: TodoWeb.Router.Helpers.post_index_path(@socket, :index, page: %{page: @page_number + 1}),
      class: "pagination-link"
    ) %>
  <% end %>
</div>

<.modal :if={@live_action in [:new, :edit]} id="post-modal" show on_cancel={JS.patch(~p"/posts")}>
  <.live_component
    module={TodoWeb.PostLive.FormComponent}
    id={@post.id || :new}
    title={@page_title}
    action={@live_action}
    post={@post}
    patch={~p"/posts"}
  />
</.modal>
