<h1>Create a New Task</h1>

<.simple_form
  :let={f}
  for={@changeset}
  id="task-form"
  action={TodoWeb.Router.Helpers.page_path(@conn, :create)}
  method="post"
>
  <.input field={f[:title]} type="text" label="Name" />
  <.input field={f[:description]} type="textarea" label="Description" />
  <:actions>
    <.button phx-disable-with="Creating...">Create Task</.button>
  </:actions>
</.simple_form>

<%= live_patch("Back to List", to: TodoWeb.Router.Helpers.page_path(@conn, :index)) %>
